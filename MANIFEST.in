# The sdist carries the sources, the README, the licence, and the engine's published hashes
# and SBOM — and nothing else.
include ENGINE-SHA256SUMS sbom.cdx.json
# setuptools sweeps a tests/ directory beside pyproject.toml into the sdist by default; the
# prune below keeps tests/ out of the published tarball (they run in CI, from the repo).
prune tests
global-exclude *.pyc
global-exclude __pycache__/*
prune build
prune .pytest_cache
